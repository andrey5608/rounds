# Everything that is not needed to run the extension.
temp/**
.github/**
.vscode/**
src/**
out/**
docs/**
# The brand assets live under docs/, but three of them are needed at runtime: the marketplace icon,
# the activity bar glyph the manifest points at, and the image the README shows. The vector originals
# and the preview stay out of the package.
!docs/media/rounds-icon-128.png
!docs/media/rounds-activitybar.svg
!docs/media/rounds-lockup.png
coverage/**
scripts/**
node_modules/**
plan.md
AGENTS.md
CLAUDE.md
CONTRIBUTING.md
tsconfig.json
eslint.config.mjs
esbuild.js
.vscode-test.mjs
.mocharc.json
.c8rc.json
.gitignore
.editorconfig
**/*.map
**/*.ts
# The agent panel's script is loaded by the webview as a file rather than bundled, so it ships.
!media/agentPanel.js
