{
  "name": "rounds",
  "displayName": "Rounds — Scheduled Task Agents",
  "publisher": "TODO-PUBLISHER",
  "version": "0.0.1",
  "description": "Recurring agents that collect data from an issue tracker or a repository host, run a prompt through a language model, and store the result.",
  "categories": [
    "Other"
  ],
  "keywords": [
    "agents",
    "schedule",
    "automation",
    "cron"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/andrey5608/rounds.git"
  },
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "engines": {
    "vscode": "^1.95.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "rounds.createAgent",
        "title": "Create Agent",
        "category": "Rounds",
        "icon": "$(add)"
      },
      {
        "command": "rounds.editAgent",
        "title": "Edit Agent",
        "category": "Rounds",
        "icon": "$(edit)"
      },
      {
        "command": "rounds.duplicateAgent",
        "title": "Duplicate Agent",
        "category": "Rounds",
        "icon": "$(copy)"
      },
      {
        "command": "rounds.deleteAgent",
        "title": "Delete Agent",
        "category": "Rounds",
        "icon": "$(trash)"
      },
      {
        "command": "rounds.toggleAgent",
        "title": "Enable or Disable Agent",
        "category": "Rounds",
        "icon": "$(circle-slash)"
      },
      {
        "command": "rounds.runNow",
        "title": "Run Now",
        "category": "Rounds",
        "icon": "$(play)"
      },
      {
        "command": "rounds.openResultFolder",
        "title": "Open Result Folder",
        "category": "Rounds",
        "icon": "$(folder-opened)"
      },
      {
        "command": "rounds.showHistory",
        "title": "Show Run History",
        "category": "Rounds",
        "icon": "$(history)"
      },
      {
        "command": "rounds.checkSetup",
        "title": "Check Setup",
        "category": "Rounds",
        "icon": "$(checklist)"
      },
      {
        "command": "rounds.refreshView",
        "title": "Refresh",
        "category": "Rounds",
        "icon": "$(refresh)"
      },
      {
        "command": "rounds.showOutput",
        "title": "Show Output",
        "category": "Rounds",
        "icon": "$(output)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rounds",
          "title": "Rounds",
          "icon": "$(history)"
        }
      ]
    },
    "views": {
      "rounds": [
        {
          "id": "rounds.agentsView",
          "name": "Agents"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "rounds.createAgent",
          "when": "view == rounds.agentsView",
          "group": "navigation@1"
        },
        {
          "command": "rounds.refreshView",
          "when": "view == rounds.agentsView",
          "group": "navigation@2"
        },
        {
          "command": "rounds.checkSetup",
          "when": "view == rounds.agentsView",
          "group": "1_setup@1"
        },
        {
          "command": "rounds.showOutput",
          "when": "view == rounds.agentsView",
          "group": "1_setup@2"
        }
      ],
      "view/item/context": [
        {
          "command": "rounds.runNow",
          "when": "view == rounds.agentsView && viewItem =~ /^rounds\\.agent/",
          "group": "inline@1"
        },
        {
          "command": "rounds.toggleAgent",
          "when": "view == rounds.agentsView && viewItem =~ /^rounds\\.agent/",
          "group": "inline@2"
        },
        {
          "command": "rounds.editAgent",
          "when": "view == rounds.agentsView && viewItem =~ /^rounds\\.agent/",
          "group": "1_modify@1"
        },
        {
          "command": "rounds.duplicateAgent",
          "when": "view == rounds.agentsView && viewItem =~ /^rounds\\.agent/",
          "group": "1_modify@2"
        },
        {
          "command": "rounds.openResultFolder",
          "when": "view == rounds.agentsView && viewItem =~ /^rounds\\.agent/",
          "group": "2_results@1"
        },
        {
          "command": "rounds.showHistory",
          "when": "view == rounds.agentsView && viewItem =~ /^rounds\\.agent/",
          "group": "2_results@2"
        },
        {
          "command": "rounds.deleteAgent",
          "when": "view == rounds.agentsView && viewItem =~ /^rounds\\.agent/",
          "group": "3_danger@1"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "rounds.agentsView",
        "when": "!rounds.hasAgents",
        "contents": "No agents yet. An agent visits a source on a schedule, runs your prompt through a language model and stores the result.\n[Create Agent](command:rounds.createAgent)\n[Check Setup](command:rounds.checkSetup)"
      }
    ]
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "compile:tests": "tsc -p ./",
    "typecheck": "tsc -p ./ --noEmit",
    "lint": "eslint .",
    "check": "node scripts/check-language.mjs && node scripts/check-dependencies.mjs && node scripts/check-unit-tests.mjs",
    "test:unit": "node scripts/check-unit-tests.mjs && npm run compile:tests && mocha \"out/**/*.unit.test.js\"",
    "test:integration": "npm run compile:tests && vscode-test",
    "test": "npm run test:unit && npm run test:integration"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/proper-lockfile": "^4.1.4",
    "@types/vscode": "~1.95.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "mocha": "^11.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "cron-parser": "^5.10.0",
    "cronstrue": "^3.24.0",
    "proper-lockfile": "^4.1.2"
  }
}
